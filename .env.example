# ------------------------------------------------------------
# Ducks Offroad - configuração (copie para .env e ajuste)
# ------------------------------------------------------------
APP_NAME="Ducks Offroad"
APP_ENV=production          # production | development
APP_DEBUG=false             # NUNCA deixe true em produção
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

# Banco de dados: sqlite (simples) ou mysql (recomendado em hospedagem)
DB_DRIVER=sqlite
DB_PATH=storage/data/ducks.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ducks_offroad
DB_USER=ducks
DB_PASS=

# Admin inicial (criado automaticamente se ainda não existir nenhum admin).
# Depois do primeiro acesso, APAGUE a senha daqui.
ADMIN_NAME="Administrador"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Instagram - API do Instagram com Login do Instagram (conta Profissional/Criador).
# O token também pode ser cadastrado pelo painel em /admin/instagram
INSTAGRAM_USERNAME=ducksoffroad
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_SYNC_MINUTES=60

# E-mail (recuperação de senha). Com MAIL_ENABLED=false os e-mails vão para storage/logs/mail.log
MAIL_ENABLED=false
MAIL_FROM=nao-responda@ducksoffroad.com.br
MAIL_FROM_NAME="Ducks Offroad"

# Segurança
SESSION_IDLE_MINUTES=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
UPLOAD_MAX_MB=8
