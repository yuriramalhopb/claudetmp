# ------------------------------------------------------------
# Vela da Fé — configuração (copie para .env e ajuste)
# ------------------------------------------------------------
APP_NAME="Vela da Fé"
APP_ENV=production          # production | development
APP_DEBUG=false             # NUNCA deixe true em produção
APP_URL=https://velas.suaigreja.com.br     # endereço público, sem barra no fim (usado nos e-mails)
APP_TIMEZONE=America/Sao_Paulo

# Banco de dados
#  - sqlite: um arquivo em storage/ (zero configuração; ótimo para começar)
#  - mysql : MySQL 5.7+/8 ou MariaDB 10.3+ (o painel da hospedagem cria o banco e o usuário)
DB_DRIVER=sqlite
# DB_SQLITE_PATH=/caminho/fora/da/web/vela.sqlite   # opcional
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vela_da_fe
DB_USER=vela
DB_PASS=

# Administrador inicial (criado automaticamente na primeira visita, se ainda não existir nenhum).
# Depois de entrar, APAGUE a senha daqui.
ADMIN_NAME="Administrador"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# E-mail: log (só grava em storage/logs/mail-*.log) | smtp (recomendado) | mail (função mail() do PHP)
MAIL_DRIVER=log
MAIL_FROM=nao-responda@suaigreja.com.br
MAIL_FROM_NAME="Vela da Fé"
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls          # tls (STARTTLS) | ssl | none
SMTP_USER=
SMTP_PASS=

# Pix (valores iniciais; depois dá para trocar em Admin > Configurações).
# Sem chave Pix o site oferece apenas velas gratuitas.
PIX_KEY=
PIX_NAME=
PIX_CITY=

# Segurança e backup
SESSION_IDLE_MINUTES=120
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
BACKUP_DIR=storage/backups
BACKUP_KEEP_DAYS=30
