# Apache: aponte o DocumentRoot para esta pasta "public".
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Bloqueia arquivos ocultos (.env, .git...)
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    # O service worker e o manifesto precisam ser sempre revalidados (atualizações do app)
    <FilesMatch "^(sw\.js|manifest\.webmanifest|offline\.html)$">
        Header set Cache-Control "no-cache"
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
    <FilesMatch "^(?!sw\.js$).*\.(css|js|svg|jpg|jpeg|png|webp|gif|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# Limites de upload (ajuste se o host permitir)
<IfModule mod_php.c>
    php_value upload_max_filesize 8M
    php_value post_max_size 64M
    php_value max_file_uploads 30
    php_flag expose_php Off
</IfModule>
