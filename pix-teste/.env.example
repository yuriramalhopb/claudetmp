# Banco de dados MySQL / MariaDB (a tabela é criada sozinha na primeira execução)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pix_teste
DB_USER=pix
DB_PASS=

# Access Token da sua conta Mercado Pago
# Painel: https://www.mercadopago.com.br/developers/panel -> Suas integrações -> Credenciais
# Use o de PRODUÇÃO (APP_USR-...) para receber Pix de verdade na sua conta.
MP_ACCESS_TOKEN=

# E-mail usado como "pagador" na cobrança (o Mercado Pago exige um). Pode ser o seu.
PAYER_EMAIL=

# Minutos até a cobrança expirar
PIX_EXPIRA_MIN=30

# URL pública deste sistema (só necessária pro webhook; sem ela a confirmação é por consulta automática).
# Ex.: https://seudominio.com.br/pix-teste
APP_URL=

# (Opcional) Assinatura secreta do webhook, em Suas integrações -> Webhooks
MP_WEBHOOK_SECRET=

# (Opcional) Senha (usuário: admin) para proteger as páginas. Recomendado se publicar online.
APP_PASSWORD=
